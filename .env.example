# College Basketball Data API (https://collegebasketballdata.com)
# Server-side only — never exposed to the client.
CBBD_API_KEY=your-key-here

# EmailJS contact form (public keys — safe to expose)
PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
PUBLIC_EMAILJS_PUBLIC_KEY=your-public-api-key
