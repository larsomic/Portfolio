# College Basketball Data API (https://collegebasketballdata.com)
# Server-side only — never exposed to the client.
CBBD_API_KEY=your-key-here

# Alpaca Market Data API (https://alpaca.markets — free "Basic" plan is enough)
# Get the keys at: https://app.alpaca.markets/account
# Server-side only — they are attached as APCA-API-KEY-ID / APCA-API-SECRET-KEY
# headers inside /api/market/* and never shipped to the browser.
ALPACA_API_KEY_ID=your-key-id
ALPACA_API_SECRET_KEY=your-secret-key
# Optional: "iex" (free) or "sip" (paid consolidated feed). Defaults to iex.
# ALPACA_DATA_FEED=iex

# EmailJS contact form (public keys — safe to expose)
PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
PUBLIC_EMAILJS_PUBLIC_KEY=your-public-api-key
